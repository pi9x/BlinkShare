{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=blinkshare;Username=postgres;Password=blinkshare_dev_password"
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "PublicUrl": "http://localhost:9000",
    "BucketName": "blinkshare",
    "AccessKey": "CHANGE_ME_GARAGE_ACCESS_KEY",
    "SecretKey": "CHANGE_ME_GARAGE_SECRET_KEY",
    "Region": "garage",
    "ForcePathStyle": true
  },
  "Worker": {
    "ExpireShares": {
      "IntervalSeconds": 30
    },
    "CleanupObjects": {
      "IntervalSeconds": 30,
      "BatchSize": 100
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
